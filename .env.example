# Traefik Dashboard Configuration
TRAEFIK_DASHBOARD_DOMAIN=traefik.example.com
# Generate with: htpasswd -nb admin yourpassword | sed -e s/\$/\$\$/g
# (the doubled $$ are required for docker-compose interpolation)
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xxxxxxxx$$xxxxxxxxxxxxxxxxxxxxxx

# ACME / Let's Encrypt account email.
# REQUIRED: must be a real, reachable address; example.com is rejected
# by Let's Encrypt. Injected into Traefik via
# TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT_ACME_EMAIL in docker-compose.yml.
ACME_EMAIL=you@yourdomain.com

# SSL Certificate Resolver name (must match a resolver in traefik.yml)
CERT_RESOLVER=letsencrypt

# DNS Provider Configuration (only needed for DNS challenge / wildcards)
# Cloudflare example — leave blank if using HTTP challenge.
CF_API_EMAIL=
CF_DNS_API_TOKEN=
